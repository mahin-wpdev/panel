<script>{literal}$(document).on('click','.live-check',function(){var b=$(this),r=b.siblings('.live-result');b.prop('disabled',true);r.text('Checking…');$.getJSON(b.data('url')).done(function(d){r.text(d.status).css('color',d.status==='Online'?'green':(d.status==='Offline'?'#b58900':'#c00'));}).fail(function(){r.text('Unavailable').css('color','#c00');}).always(function(){b.prop('disabled',false);});});{/literal}</script>

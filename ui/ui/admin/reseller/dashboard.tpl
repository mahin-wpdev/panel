<div class="row"><div class="col-md-6"><div class="box box-success"><div class="box-header"><h3 class="box-title">Create / Update Reseller</h3></div><form method="post" action="{Text::url('reseller/save')}"><div class="box-body"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="form-group"><label>Agent account</label><select class="form-control" name="user_id" required><option value="">Select Agent account</option>{foreach $agents as $agent}<option value="{$agent['id']}">{$agent['fullname']|escape} ({$agent['username']|escape})</option>{/foreach}</select></div><div class="form-group"><label>Reseller code</label><input class="form-control" name="reseller_code" placeholder="e.g. shahin"></div><div class="form-group"><label>Customer username suffix</label><input class="form-control" name="customer_prefix" placeholder="e.g. liku"><small>Reseller-created customers use <b>customer.suffix</b>.</small></div><div class="form-group"><label>Display name</label><input class="form-control" name="name"></div><div class="row"><div class="col-sm-6"><div class="form-group"><label>Mobile</label><input class="form-control" name="mobile"></div></div><div class="col-sm-6"><div class="form-group"><label>Email</label><input class="form-control" name="email"></div></div></div><div class="form-group"><label>Commission / Profit share %</label><input class="form-control" type="number" min="0" max="100" step="0.01" name="profit_percentage" value="0"></div><div class="form-group"><label>Status</label><select class="form-control" name="status"><option value="active">Active</option><option value="suspended">Suspended</option><option value="disabled">Disabled</option></select></div><div class="form-group"><label>Allowed packages</label><select class="form-control" name="package_ids[]" multiple size="5">{foreach $plans as $plan}<option value="{$plan['id']}">{$plan['name_plan']|escape} — {Lang::moneyFormat($plan['price'])}</option>{/foreach}</select></div><div class="form-group"><label>Admin notes</label><textarea class="form-control" name="notes"></textarea></div></div><div class="box-footer"><button class="btn btn-success">Save reseller</button></div></form></div></div>
<div class="col-md-6"><div class="box box-info"><div class="box-header"><h3 class="box-title">Customer Ownership</h3></div><form method="post" action="{Text::url('reseller/assign')}"><div class="box-body"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="form-group"><label>Assign to reseller</label><select class="form-control" name="reseller_id" required><option value="">Select reseller</option>{foreach $resellers as $reseller}{if $reseller['status']=='active'}<option value="{$reseller['id']}">{$reseller['name']|escape}</option>{/if}{/foreach}</select></div><div class="form-group"><label>Customer</label><select class="form-control" name="customer_id" required><option value="">Select customer</option>{foreach $customers as $customer}<option value="{$customer['id']}">{$customer['fullname']|escape} ({$customer['username']|escape})</option>{/foreach}</select></div></div><div class="box-footer"><button class="btn btn-info">Assign customer</button></div></form><form method="post" action="{Text::url('reseller/unassign')}"><div class="box-body"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="form-group"><label>Return to Main ISP</label><select class="form-control" name="customer_id" required><option value="">Select assigned customer</option>{foreach $customers as $customer}{if $customer['reseller_id']}<option value="{$customer['id']}">{$customer['fullname']|escape} ({$customer['username']|escape})</option>{/if}{/foreach}</select></div></div><div class="box-footer"><button class="btn btn-warning">Set as Main ISP customer</button></div></form></div></div></div>
{/if}
{if !$is_reseller_view}
<div class="box box-info" id="bulk-customer-assignment"><div class="box-header"><h3 class="box-title"><i class="fa fa-object-group"></i> Bulk Customer Ownership</h3><span class="pull-right text-muted">Assign multiple existing customers to one reseller</span></div><form method="post" action="{Text::url('reseller/bulk-assign')}"><div class="box-body row"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="col-md-4"><label>Target reseller</label><select class="form-control select2" name="reseller_id" required><option value="">Select active reseller</option>{foreach $resellers as $reseller}{if $reseller['status']=='active'}<option value="{$reseller['id']}">{$reseller['name']|escape} ({$reseller['username']|escape})</option>{/if}{/foreach}</select></div><div class="col-md-8"><label>Customers</label><select class="form-control select2" name="customer_ids[]" multiple required>{foreach $customers as $customer}<option value="{$customer['id']}">{$customer['fullname']|escape} — {$customer['username']|escape}{if $customer['reseller_id']} (currently assigned){/if}</option>{/foreach}</select><small class="text-muted">Search by name or PPPoE username, then choose as many customers as needed.</small></div></div><div class="box-footer"><button class="btn btn-info"><i class="fa fa-check"></i> Assign Selected Customers</button></div></form></div>
<div class="box box-warning"><div class="box-header"><h3 class="box-title">Manual Profit Settlement</h3></div><form method="post" action="{Text::url('reseller/settle')}"><div class="box-body row"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="col-md-3"><select class="form-control" name="reseller_id" required><option value="">Select reseller</option>{foreach $resellers as $reseller}<option value="{$reseller['id']}">{$reseller['name']|escape}</option>{/foreach}</select></div><div class="col-md-2"><input class="form-control" name="amount" type="number" min="0.01" step="0.01" placeholder="Amount" required></div><div class="col-md-2"><input class="form-control" name="payment_method" placeholder="Method (Cash/bKash)" required></div><div class="col-md-2"><input class="form-control" name="reference" placeholder="Reference"></div><div class="col-md-2"><input class="form-control" name="note" placeholder="Note"></div><div class="col-md-1"><button class="btn btn-warning">Settle</button></div></div></form></div>
<div class="box box-default"><div class="box-header"><h3 class="box-title">Allowed Packages by Reseller</h3><div class="box-tools"><a class="btn btn-primary btn-sm" href="{Text::url('services/pppoe-add')}"><i class="fa fa-plus"></i> Create PPPoE Package</a> <a class="btn btn-default btn-sm" href="{Text::url('services/add')}"><i class="fa fa-plus"></i> Create Hotspot Package</a></div></div><form method="post" action="{Text::url('reseller/packages')}"><div class="box-body row"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="col-md-3"><select class="form-control" name="reseller_id" required><option value="">Select reseller</option>{foreach $resellers as $reseller}<option value="{$reseller['id']}">{$reseller['name']|escape}</option>{/foreach}</select></div><div class="col-md-8"><select class="form-control" name="package_ids[]" multiple size="5" required>{foreach $plans as $plan}<option value="{$plan['id']}">{$plan['name_plan']|escape} — {Lang::moneyFormat($plan['price'])}</option>{/foreach}</select><small>Use Ctrl/Command to select multiple packages.</small></div><div class="col-md-1"><button class="btn btn-default">Save</button></div></div></form></div>
{/if}
{if $is_reseller_view && $reseller_screen eq 'customer-view'}{if $customer_onu}<div class="box box-info"><div class="box-header"><h3 class="box-title"><i class="fa fa-sitemap"></i> ONU Network Status</h3><span class="pull-right"><b>{$customer_onu['status']|escape}</b></span></div><div class="box-body"><div class="row"><div class="col-md-4"><dl><dt>OLT</dt><dd>{$customer_onu['name']|escape}</dd><dt>PON / ONU ID</dt><dd>{$customer_onu['slot_number']}/{$customer_onu['pon_port']} / {$customer_onu['onu_id']}</dd><dt>Serial Number</dt><dd>{$customer_onu['serial_number']|escape}</dd></dl></div><div class="col-md-4"><dl><dt>MAC Address</dt><dd>{$customer_onu['mac_address']|escape}</dd><dt>RX Power</dt><dd>{if $customer_onu['rx_power']!==null}{$customer_onu['rx_power']} dBm{else}N/A{/if}</dd><dt>TX Power</dt><dd>{if $customer_onu['tx_power']!==null}{$customer_onu['tx_power']} dBm{else}N/A{/if}</dd></dl></div><div class="col-md-4"><dl><dt>Distance</dt><dd>{if $customer_onu['distance']!==null}{$customer_onu['distance']} m{else}N/A{/if}</dd><dt>LOS</dt><dd>{$customer_onu['los_status']|escape}</dd><dt>Last Seen</dt><dd>{$customer_onu['last_seen']|escape}</dd></dl></div></div></div></div>{else}<div class="alert alert-info">No ONU is assigned to this customer.</div>{/if}{/if}
{if !$is_reseller_view}<div class="box box-default" id="activity-section"><div class="box-header"><h3 class="box-title"><i class="fa fa-history"></i> Reseller Activity Logs</h3></div><div class="box-body table-responsive"><table class="table table-bordered table-striped"><thead><tr><th>Date</th><th>Action</th><th>Reseller</th><th>Customer</th><th>Details</th></tr></thead><tbody>{foreach $activity_logs as $log}<tr><td>{$log['created_at']|escape}</td><td>{$log['action']|escape}</td><td>{$log['reseller_id']|escape}</td><td>{$log['customer_id']|escape}</td><td>{$log['details']|escape}</td></tr>{foreachelse}<tr><td colspan="5" class="text-center">No reseller activity recorded yet.</td></tr>{/foreach}</tbody></table></div></div>{/if}
<script>{literal}document.addEventListener('DOMContentLoaded',function(){if({/literal}{if $is_reseller_view}true{else}false{/if}{literal}){var old=[].slice.call(document.querySelectorAll('.box-title')).find(function(x){return x.textContent.trim()==='My Customer ONU Status';});if(old)old.closest('.box').remove();return;}var section='{/literal}{$admin_section|default:'dashboard'}{literal}';if(!section)return;var all=document.querySelectorAll('.reseller-shell > .box,.reseller-shell > .row');var keep={dashboard:['Reseller Management','Business Overview','Quick Actions'],resellers:['Reseller Management','Create / Update Reseller'],ownership:['Customer Ownership','Bulk Customer Ownership'],packages:['Allowed Packages by Reseller'],earnings:['Reseller Management'],settlements:['Manual Profit Settlement'],activity:['Reseller Activity Logs']}[section]||[];all.forEach(function(node){var title=node.querySelector('.box-title');if(title&&keep.indexOf(title.textContent.trim())===-1)node.style.display='none';});if(section==='ownership'){document.querySelectorAll('#bulk-customer-assignment').forEach(function(n){n.style.display='block';});}if(section==='activity'){var a=document.getElementById('activity-section');if(a)a.style.display='block';}});{/literal}</script>
</div>{include file="sections/footer.tpl"}

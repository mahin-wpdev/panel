 <div class="col-lg-3 col-md-6"><div class="small-box bg-aqua"><div class="inner"><h3>{$owned_total}</h3><p>My Customers</p></div><div class="icon"><i class="fa fa-users"></i></div><a href="{Text::url('reseller/customers')}" class="small-box-footer">View customers <i class="fa fa-arrow-circle-right"></i></a></div></div>

{include file="sections/header.tpl"}
<style>{literal}.reseller-shell .box{border-radius:10px;border-top-width:3px;box-shadow:0 5px 18px rgba(31,55,85,.08)}.reseller-shell .box-header{padding:14px 18px}.reseller-shell .box-body{padding:18px}.reseller-shell .small-box{border-radius:10px;overflow:hidden;box-shadow:0 6px 16px rgba(30,50,80,.13)}.reseller-shell .info-box{border-radius:10px;box-shadow:0 4px 14px rgba(30,50,80,.08)}.reseller-shell .table>thead>tr>th{background:#f4f7fb;color:#41536d;border-bottom:2px solid #e0e8f0}.reseller-shell .table>tbody>tr:hover{background:#f8fbff}.reseller-shell .btn{border-radius:5px}{/literal}</style>
<div class="reseller-shell">
{if $is_reseller_view}
{if $reseller_screen eq 'customer-add'}
<div class="box box-primary"><div class="box-header"><h3 class="box-title">Add Reseller Customer</h3></div><form method="post" action="{Text::url('reseller/customer-save')}"><div class="box-body row"><input type="hidden" name="csrf_token" value="{$csrf_token}"><div class="col-md-6"><div class="form-group"><label>Username</label><div class="input-group"><input class="form-control" name="username" required pattern="[A-Za-z0-9_-]+" placeholder="customer-name"><span class="input-group-addon">.{$profile['customer_prefix']|escape}</span></div><small>Final PPPoE/customer username is generated automatically.</small></div><div class="form-group"><label>Full name</label><input class="form-control" name="fullname" required></div><div class="form-group"><label>Mobile</label><input class="form-control" name="phonenumber" required></div></div><div class="col-md-6"><div class="form-group"><label>Initial password</label><input class="form-control" type="password" name="password" required minlength="3"></div><div class="form-group"><label>Email</label><input class="form-control" type="email" name="email"></div><div class="form-group"><label>Address</label><textarea class="form-control" name="address"></textarea></div><div class="form-group"><label>Service type</label><select class="form-control" name="service_type"><option value="PPPOE">PPPoE</option><option value="Hotspot">Hotspot</option><option value="Others">Other</option></select></div>{if $profile['allow_whatsapp']}<div class="checkbox"><label><input type="checkbox" name="send_whatsapp" value="1" checked> WhatsApp</label></div>{/if}{if $profile['allow_sms']}<div class="checkbox"><label><input type="checkbox" name="send_sms" value="1"> SMS</label></div>{/if}{if $profile['allow_email']}<div class="checkbox"><label><input type="checkbox" name="send_mail" value="1"> Email</label></div>{/if}</div></div><div class="box-footer"><button class="btn btn-primary">Create customer</button> <span class="text-muted">New accounts are Inactive until an administrator configures router/package and activates them.</span></div></form></div>
{elseif $reseller_screen eq 'customers'}
<div class="box box-primary"><div class="box-header with-border"><h3 class="box-title"><i class="fa fa-users"></i> My Customers</h3><div class="box-tools"><a class="btn btn-success btn-sm" href="{Text::url('reseller/customer-add')}"><i class="fa fa-user-plus"></i> Add Customer</a></div></div><div class="box-body"><form class="form-inline" method="get" action="{Text::url('reseller/customers')}"><input type="hidden" name="_route" value="reseller/customers"><div class="form-group"><input class="form-control" name="search" value="{$search|escape}" placeholder="Search name, username or mobile"></div> <div class="form-group"><select class="form-control" name="filter"><option value="all">All statuses</option>{foreach $statuses as $status}<option value="{$status|escape}" {if $filter eq $status}selected{/if}>{$status|escape}</option>{/foreach}</select></div> <button class="btn btn-default"><i class="fa fa-search"></i> Search</button></form><hr><div class="table-responsive"><table class="table table-bordered table-striped"><thead><tr><th>Username / PPPoE</th><th>Customer</th><th>Mobile</th><th>Service</th><th>Status</th><th></th></tr></thead><tbody>{foreach $d as $customer}<tr><td>{$customer['username']|escape}</td><td>{$customer['fullname']|escape}</td><td>{$customer['phonenumber']|escape}</td><td>{$customer['service_type']|escape}</td><td>{$customer['status']|escape}</td><td><a class="btn btn-xs btn-primary" href="{Text::url('reseller/customer-view/')}{$customer['id']}">View</a></td></tr>{foreachelse}<tr><td colspan="6" class="text-center text-muted">No customers are assigned to this reseller.</td></tr>{/foreach}</tbody></table></div></div></div>
{elseif $reseller_screen eq 'customer-view' || $reseller_screen eq 'customer-edit'}
<div class="box box-primary"><div class="box-header"><h3 class="box-title">{$selected_customer['fullname']|escape}</h3></div><div class="box-body">
{if $reseller_screen eq 'customer-edit'}
<form method="post" action="{Text::url('reseller/customer-update')}"><input type="hidden" name="csrf_token" value="{$csrf_token}"><input type="hidden" name="customer_id" value="{$selected_customer['id']}"><div class="row"><div class="col-md-6"><div class="form-group"><label>Full name</label><input class="form-control" name="fullname" value="{$selected_customer['fullname']|escape}" required></div><div class="form-group"><label>Mobile</label><input class="form-control" name="phonenumber" value="{$selected_customer['phonenumber']|escape}"></div></div><div class="col-md-6"><div class="form-group"><label>Email</label><input class="form-control" name="email" value="{$selected_customer['email']|escape}"></div><div class="form-group"><label>Address</label><textarea class="form-control" name="address">{$selected_customer['address']|escape}</textarea></div></div></div><button class="btn btn-primary">Save basic details</button></form>
{else}
<div class="row"><div class="col-md-4"><dl><dt>Username / PPPoE</dt><dd>{$selected_customer['username']|escape}</dd><dt>Mobile</dt><dd>{$selected_customer['phonenumber']|escape}</dd><dt>Account status</dt><dd>{$selected_customer['status']|escape}</dd></dl></div><div class="col-md-4"><dl><dt>Current package</dt><dd>{if $customer_package}{$customer_package['namebp']|escape}{else}No active package{/if}</dd><dt>Expiry</dt><dd>{if $customer_package}{$customer_package['expiration']} {$customer_package['time']}{else}—{/if}</dd><dt>Address</dt><dd>{$selected_customer['address']|escape}</dd></dl></div><div class="col-md-4"><dl><dt>ONU</dt><dd>{if $customer_onu}{$customer_onu['serial_number']|escape} ({$customer_onu['status']|escape}){else}Not assigned{/if}</dd><dt>Network administration</dt><dd>Router, package, recharge and ONU changes are managed by Admin.</dd></dl></div></div><div class="box box-primary"><div class="box-header"><h3 class="box-title">Traffic Monitor & Total Data Usage</h3><span class="pull-right text-muted">Auto refresh: 5 seconds</span></div><div class="box-body"><div id="reseller-traffic-state" class="text-muted">Connecting to MikroTik monitor…</div><div id="reseller-traffic-data" class="row" style="display:none"><div class="col-md-3"><b>Accounting Download</b><div id="rt-download">—</div></div><div class="col-md-3"><b>Accounting Upload</b><div id="rt-upload">—</div></div><div class="col-md-3"><b>Accounting Total</b><div id="rt-total">—</div></div><div class="col-md-3"><b>Status</b><div id="rt-status">—</div></div><div class="col-md-3"><b>Current Download</b><div id="rt-downspeed">—</div></div><div class="col-md-3"><b>Current Upload</b><div id="rt-upspeed">—</div></div><div class="col-md-3"><b>Interface Total Usage</b><div id="rt-session">—</div></div><div class="col-md-3"><b>Uptime</b><div id="rt-uptime">—</div></div></div></div></div><script>{literal}(function(){function loadResellerTraffic(){$.getJSON('{/literal}{Text::url('reseller/traffic/')}{$selected_customer['id']}{literal}').done(function(x){$('#rt-download').text(x.total_download);$('#rt-upload').text(x.total_upload);$('#rt-total').text(x.total_usage);$('#rt-status').text(x.connected===true?'Online':(x.connected===false?'Offline':'Unavailable'));$('#rt-downspeed').text(x.download_speed);$('#rt-upspeed').text(x.upload_speed);$('#rt-session').text(x.session_total);$('#rt-uptime').text(x.uptime);$('#reseller-traffic-data').show();$('#reseller-traffic-state').text(x.accounting_available?'Live monitor + accounting total updated.':'Live monitor updated; accounting record unavailable.');}).fail(function(){$('#reseller-traffic-state').text('Traffic monitor is unavailable.');});}loadResellerTraffic();setInterval(loadResellerTraffic,5000);})();{/literal}</script><hr><h4>Recent payment / recharge history</h4><div class="table-responsive"><table class="table table-condensed"><thead><tr><th>Date</th><th>Plan</th><th>Amount</th><th>Method</th><th></th></tr></thead><tbody>{foreach $customer_transactions as $transaction}<tr><td>{$transaction['recharged_on']}</td><td>{$transaction['plan_name']|escape}</td><td>{Lang::moneyFormat($transaction['price'])}</td><td>{$transaction['method']|escape}</td><td><a class="btn btn-xs btn-default" href="{Text::url('reseller/invoice/')}{$transaction['id']}">Invoice</a></td></tr>{foreachelse}<tr><td colspan="5">No recharge record.</td></tr>{/foreach}</tbody></table></div>{/if}</div></div>
{elseif $reseller_screen eq 'report'}

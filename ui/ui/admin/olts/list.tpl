{include file="sections/header.tpl"}
<div class="row"><div class="col-md-4"><div class="small-box bg-aqua"><div class="inner"><h3>{$olts|@count}</h3><p>Total OLT</p></div><div class="icon"><i class="fa fa-sitemap"></i></div></div></div><div class="col-md-4"><div class="small-box bg-green"><div class="inner"><h3>{$total_online|default:0}</h3><p>Online ONU</p></div><div class="icon"><i class="fa fa-signal"></i></div></div></div><div class="col-md-4"><div class="small-box bg-yellow"><div class="inner"><h3>{$total_onu|default:0}</h3><p>Discovered ONU</p></div><div class="icon"><i class="fa fa-plug"></i></div></div></div></div>
<div class="row"><div class="col-md-12"><div class="box box-primary"><div class="box-header"><h3 class="box-title">OLT Dashboard</h3><a class="btn btn-primary pull-right" href="{Text::url('olts/add')}"><i class="fa fa-plus"></i> Add OLT</a></div><div class="box-body table-responsive"><table class="table table-bordered table-striped"><thead><tr><th>Name</th><th>Vendor / Model</th><th>Host</th><th>Status</th><th>ONU</th><th>Last Sync</th><th>Actions</th></tr></thead><tbody>{foreach $olts as $o}<tr><td><b>{$o['name']|escape}</b></td><td>{$o['vendor']|escape} {$o['model']|escape}</td><td>{$o['management_host']|escape}:{$o['port']}</td><td>{$o['status']}</td><td>{$o['online_count']}/{$o['onu_count']} online</td><td>{$o['last_sync_at']|default:'Never'}</td><td><form method="post" action="{Text::url('olts/test')}" style="display:inline"><input type="hidden" name="token" value="{$csrf_token}"><input type="hidden" name="id" value="{$o['id']}"><button class="btn btn-xs btn-info">Test</button></form> <form method="post" action="{Text::url('olts/sync')}" style="display:inline"><input type="hidden" name="token" value="{$csrf_token}"><input type="hidden" name="id" value="{$o['id']}"><button class="btn btn-xs btn-success">Sync</button></form> <a class="btn btn-xs btn-default" href="{Text::url('olts/edit/', $o['id'])}">Edit</a></td></tr>{foreachelse}<tr><td colspan="7" class="text-center">No OLT configured</td></tr>{/foreach}</tbody></table></div></div></div></div>
{include file="sections/footer.tpl"}

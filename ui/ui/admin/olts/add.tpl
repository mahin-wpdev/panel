{include file="sections/header.tpl"}<div class="row"><div class="col-md-8"><div class="box box-primary"><div class="box-header"><h3 class="box-title">Add OLT</h3></div><form method="post" action="{Text::url('olts/save')}"><input type="hidden" name="token" value="{$csrf_token}"><div class="box-body"><div class="row">{foreach ['name'=>'OLT Name','vendor'=>'Vendor','model'=>'Model','management_host'=>'Management IP / Hostname','management_vlan'=>'Management VLAN','location'=>'Location','area'=>'Area','username'=>'Username'] as $field=>$label}<div class="col-md-6"><div class="form-group"><label>{$label}</label><input required="{if $field=='name' || $field=='vendor' || $field=='management_host'}required{/if}" class="form-control" name="{$field}"></div></div>{/foreach}<div class="col-md-6"><div class="form-group"><label>Protocol</label><select class="form-control" name="protocol"><option value="telnet">Telnet</option><option value="ssh">SSH</option><option value="snmp">SNMP</option><option value="api">Vendor API</option></select></div></div><div class="col-md-6"><div class="form-group"><label>Port</label><input class="form-control" name="port" type="number" value="23" min="1" max="65535"></div></div><div class="col-md-6"><div class="form-group"><label>Password</label><input class="form-control" name="password" type="password" autocomplete="new-password"></div></div><div class="col-md-12"><div class="form-group"><label>Notes</label><textarea class="form-control" name="notes"></textarea></div></div></div></div><div class="box-footer"><button class="btn btn-primary">Save securely</button></div></form></div></div></div>{include file="sections/footer.tpl"}

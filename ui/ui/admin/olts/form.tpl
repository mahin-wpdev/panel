{include file="sections/header.tpl"}<div class="row"><div class="col-md-8"><div class="box box-primary"><div class="box-header"><h3 class="box-title">{if $olt}Edit{else}Add{/if} OLT</h3></div><form method="post" action="{Text::url('olts/save')}"><input type="hidden" name="token" value="{$csrf_token}">{if $olt}<input type="hidden" name="id" value="{$olt['id']}">{/if}<div class="box-body"><div class="row">{foreach ['name'=>'OLT Name','vendor'=>'Vendor','model'=>'Model','management_host'=>'Management IP / Hostname','management_vlan'=>'Management VLAN','location'=>'Location','area'=>'Area','username'=>'Username'] as $field=>$label}<div class="col-md-6"><div class="form-group"><label>{$label}</label><input class="form-control" name="{$field}" value="{if $olt}{$olt[$field]|escape}{/if}" {if $field=='name'||$field=='vendor'||$field=='management_host'}required{/if}></div></div>{/foreach}<div class="col-md-6"><div class="form-group"><label>Protocol</label><select class="form-control" name="protocol">{foreach ['telnet'=>'Telnet','ssh'=>'SSH','snmp'=>'SNMP','api'=>'Vendor API'] as $value=>$label}<option value="{$value}" {if $olt&&$olt['protocol']==$value}selected{/if}>{$label}</option>{/foreach}</select></div></div><div class="col-md-6"><div class="form-group"><label>Port</label><input class="form-control" name="port" type="number" value="{if $olt}{$olt['port']}{else}23{/if}" min="1" max="65535" required></div></div><div class="col-md-6"><div class="form-group"><label>{if $olt}New {/if}Password</label><input class="form-control" name="password" type="password" autocomplete="new-password" {if !$olt}required{/if}><small>Stored encrypted and never displayed.</small></div></div><div class="col-md-12"><div class="form-group"><label>Notes</label><textarea class="form-control" name="notes">{if $olt}{$olt['notes']|escape}{/if}</textarea></div></div></div></div><div class="box-footer"><button class="btn btn-primary">Save OLT</button> <a href="{Text::url('olts')}" class="btn btn-default">Cancel</a></div></form></div></div></div>{include file="sections/footer.tpl"}
